<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="XPENG MQTT Bridge"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Read-only bridge. No vehicle-control actions exist. Accessibility access is restricted to the XPENG app. Unofficial community project, not affiliated with XPENG." />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Primary MQTT broker"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Primary MQTT host"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/port"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Primary port"
            android:inputType="number" />

        <CheckBox
            android:id="@+id/tls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Primary TLS (system-trusted certificates)" />

        <EditText
            android:id="@+id/username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Primary username (optional)"
            android:inputType="text" />

        <EditText
            android:id="@+id/password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Primary password (optional)"
            android:inputType="textPassword" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Secondary MQTT broker (optional)"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="When configured, identical retained state and Home Assistant discovery are published independently to both brokers. Either broker may be temporarily unavailable without blocking the other." />

        <EditText
            android:id="@+id/secondary_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Secondary MQTT host (leave empty to disable)"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/secondary_port"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Secondary port"
            android:inputType="number" />

        <CheckBox
            android:id="@+id/secondary_tls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Secondary TLS (system-trusted certificates)" />

        <EditText
            android:id="@+id/secondary_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Secondary username (optional)"
            android:inputType="text" />

        <EditText
            android:id="@+id/secondary_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Secondary password (optional)"
            android:inputType="textPassword" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Shared MQTT settings"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/base_topic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Base topic"
            android:inputType="textNoSuggestions" />

        <EditText
            android:id="@+id/discovery_prefix"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Home Assistant discovery prefix"
            android:inputType="textNoSuggestions" />

        <EditText
            android:id="@+id/interval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Interval minutes (minimum 15)"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp"
            android:text="Android enforces a minimum 15-minute periodic interval. Locked or sleeping phones may not render XPENG, so scheduled collection can time out and retry. Disable battery optimization for best reliability." />

        <Button
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save &amp; Schedule" />

        <Button
            android:id="@+id/accessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open Accessibility Settings" />

        <Button
            android:id="@+id/collect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Collect Now" />

        <Button
            android:id="@+id/test_schedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Test Automation in 1 Minute" />

        <Button
            android:id="@+id/test_publish"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Publish Local Test (No XPENG)" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="16dp"
            android:text="Configure settings, enable accessibility, then collect." />

    </LinearLayout>
</ScrollView>
