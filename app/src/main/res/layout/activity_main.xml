<?xml version="1.0" encoding="utf-8"?><ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="XPENG MQTT Bridge" android:textSize="24sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Read-only bridge. No vehicle-control actions exist. Accessibility access is restricted to the XPENG app. Unofficial community project, not affiliated with XPENG."/>
<EditText android:id="@+id/host" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="MQTT host" android:inputType="textUri"/><EditText android:id="@+id/port" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Port" android:inputType="number"/><CheckBox android:id="@+id/tls" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TLS (system-trusted certificates)"/><EditText android:id="@+id/username" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Username (optional)" android:inputType="text"/><EditText android:id="@+id/password" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Password (optional)" android:inputType="textPassword"/><EditText android:id="@+id/base_topic" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Base topic" android:inputType="textNoSuggestions"/><EditText android:id="@+id/discovery_prefix" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Home Assistant discovery prefix" android:inputType="textNoSuggestions"/><EditText android:id="@+id/interval" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Interval minutes (minimum 15)" android:inputType="number"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp" android:text="Android enforces a minimum 15-minute periodic interval. Locked or sleeping phones may not render XPENG, so scheduled collection can time out and retry. Disable battery optimization for best reliability."/><Button android:id="@+id/save" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Save &amp; Schedule"/><Button android:id="@+id/accessibility" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Open Accessibility Settings"/><Button android:id="@+id/collect" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Collect Now"/><Button android:id="@+id/test_schedule" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Test Automation in 1 Minute"/><Button android:id="@+id/test_publish" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Publish Local Test (No XPENG)"/><TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="16dp" android:text="Configure settings, enable accessibility, then collect."/></LinearLayout></ScrollView>
